// WiFi と接続先の設定。
//
// 使い方:
//   1. このファイルを secrets.local.h という名前でコピーする
//   2. 下の3通りから1つ選んで、そのブロックだけ書く
//   3. pio run -t upload
//
// secrets.local.h は .gitignore と pre-commit フックの両方で保護されており、
// コミットもプッシュもされません。認証情報はそちらにだけ書いてください。
// このテンプレート自体は公開されるので、ここに本物を書かないこと。
//
// **PC 側（pc/config.yaml の transport.link）と揃えること。**
// 選び方と手順は docs/wireless-link.md にあります。
#pragma once

// ===========================================================================
//  A. PC のモバイルホットスポットに繋ぐ（transport.link: hotspot）★おすすめ
// ===========================================================================
// WiFi ルータが要りません。PC 自身が親機になります。
// PC のインターネット接続はそのまま保てるので、開発中はこれが楽です。
//
// SSID とパスワードは Windows の「モバイル ホットスポット」の設定にあります。
// tools\hotspot.ps1 -Action Status で表示させることもできます。
//
// PC の IP は **必ず 192.168.137.1** になるので、調べる必要はありません
// （config.h の既定値がこれなので PC_HOST は書かなくてよい）。

#define WIFI_SSID     "PC のホットスポットの SSID"
#define WIFI_PASSWORD "そのパスワード"

// ===========================================================================
//  B. ロボットが親機になる（transport.link: robot-ap）
// ===========================================================================
// ルータもインターネットも要りません。ロボットの電源を入れればその場に
// 網ができます。持ち出すとき用。
//
// 代わりに PC の WiFi はこの SSID に占有され、**PC はインターネットに
// 出られなくなります**（Ollama も VOICEVOX も whisper もローカルなので
// 対話そのものは動きます）。
//
// PC からの接続先は 192.168.4.1 に固定されるので、IP を調べる作業は
// ありません。上の A のブロックは消してください。
//
// #define LINK_MODE   LINK_ROBOT_AP
// #define AP_SSID     "UsachanRobo"
// #define AP_PASSWORD "8文字以上のパスワード"   // 短いと暗号化なしになります
// #define AP_CHANNEL  6                       // 混んでいたら 1 / 11 に

// ===========================================================================
//  C. 家の WiFi ルータ経由（transport.link: router）
// ===========================================================================
// 従来の繋ぎ方です。ルータが要ります。
// PC の IP は ipconfig で調べて書いてください（DHCP で変わると繋がらなく
// なるので、ルータ側で固定しておくと楽です）。
//
// #define WIFI_SSID     "家の WiFi 名"
// #define WIFI_PASSWORD "そのパスワード"
// #define PC_HOST       "192.168.0.2"

// ---------------------------------------------------------------------------
// 既定値でよければ書かなくてよいもの
// #define PC_PORT 8765
// #define WS_PATH "/rabbit"
