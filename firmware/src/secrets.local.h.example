// WiFi と接続先の設定。
//
// 使い方:
//   1. このファイルを secrets.local.h という名前でコピーする
//   2. 自分の環境に書き換える
//   3. pio run -t upload
//
// secrets.local.h は .gitignore と pre-commit フックの両方で保護されており、
// コミットもプッシュもされません。認証情報はそちらにだけ書いてください。
// このテンプレート自体は公開されるので、ここに本物を書かないこと。
#pragma once

#define WIFI_SSID     "あなたのWiFi名"
#define WIFI_PASSWORD "あなたのWiFiパスワード"

// PC 側の IP アドレス。固定しておくと楽。
// Windows なら ipconfig で確認できる
#define PC_HOST "192.168.0.2"

// 既定値でよければ書かなくてよい
// #define PC_PORT 8765
// #define WS_PATH "/rabbit"
