#!/bin/sh
#
# 原作のセリフなど、公開してはいけない素材のコミットを止める。
#
# このリポジトリは public なので、原作の文章はローカル専用ファイルにだけ置く。
# .gitignore でも除外しているが、git add -f で押し込めてしまうため
# 最後の砦としてここでも弾く。
#
# 有効化:  git config core.hooksPath tools/hooks
# 意図的に通す場合:  git commit --no-verify

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

blocked=$(printf '%s\n' "$staged" | grep -E '(^|/)private/|\.local\.md$|\.local\.ya?ml$|(^|/)\.env($|\.)' || true)

if [ -n "$blocked" ]; then
  echo ""
  echo "  コミットを中止しました。"
  echo "  公開してはいけないファイルがステージされています:"
  echo ""
  printf '%s\n' "$blocked" | sed 's/^/      /'
  echo ""
  echo "  これらは原作のセリフや秘密情報を置くためのローカル専用ファイルです。"
  echo "  このリポジトリは public なので、コミットすると公開されます。"
  echo ""
  echo "  外す:            git restore --staged <file>"
  echo "  意図的に含める:  git commit --no-verify"
  echo ""
  exit 1
fi

exit 0
